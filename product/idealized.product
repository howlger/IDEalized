<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>

<product name="IDEalized" uid="idealized.product" id="org.idealized.customization.product" application="org.eclipse.ui.ide.workbench" version="1.0.0.qualifier" useFeatures="true" includeLaunchers="true">

   <configIni use="default"/>

   <launcherArgs>
      <programArgs>-product org.idealized.customization.product
-showsplash org.eclipse.epp.package.common
--launcher.defaultAction openFile
--launcher.appendVmargs
      </programArgs>
      <vmArgs>-Dosgi.requiredJavaVersion=21
-Dosgi.dataAreaRequiresExplicitInit=true
-Dorg.eclipse.swt.graphics.Resource.reportNonDisposed=false
-Declipse.e4.inject.javax.warning=false
-Dorg.slf4j.simpleLogger.defaultLogLevel=off
-Dsun.java.command=Eclipse
-Declipse.platform.mergeTrust=true
-XX:+UseG1GC
-XX:+UseStringDeduplication
--add-modules=ALL-SYSTEM
      </vmArgs>
      <vmArgsMac>-Xdock:icon=../Resources/Eclipse.icns -XstartOnFirstThread -Dorg.eclipse.swt.internal.carbon.smallFonts
      </vmArgsMac>
   </launcherArgs>

   <splash location="org.idealized.customization" />
   <launcher name="idealized">
      <linux icon="icons/linux.xpm"/>
      <macosx icon="icons/macos.icns">
         <bundleUrlTypes>
            <bundleUrlType scheme="eclipse+command" name="Eclipse Command"/>
            <!-- include the additional handler for mpc - this needs to be defined here so macOS entitlements work properly -->
            <bundleUrlType scheme="eclipse+mpc" name="Eclipse Marketplace"/>
         </bundleUrlTypes>
      </macosx>
      <win useIco="true">
         <ico path="icons/windows.ico"/>
         <bmp/>
      </win>
   </launcher>

   <vm>
   </vm>

   <plugins>
   </plugins>

   <features>
      <feature id="org.eclipse.platform"/>
      <feature id="org.eclipse.equinox.p2.user.ui"/>
      <feature id="org.idealized.feature" installMode="root"/>

      <!-- Eclipse Marketplace Client and Oomph Setup -->
      <feature id="org.eclipse.epp.mpc" installMode="root"/>
      <feature id="org.eclipse.oomph.setup" installMode="root"/>

      <!-- General IDE -->
      <feature id="org.eclipse.tm4e.feature" installMode="root"/>
      <feature id="org.eclipse.tm4e.language_pack.feature" installMode="root"/>
      <feature id="org.eclipse.m2e.lemminx.feature" installMode="root"/>
      <feature id="org.eclipse.tips.feature" installMode="root"/>
      <feature id="me.glindholm.plugin.quickimage2.feature" installMode="root"/>
      <!-- non-p2: <feature id="AnyEditTools" installMode="root"/> -->
      <!-- non-p2: <feature id="zipeditor" installMode="root"/> -->
      <!-- <feature id="dakara.eclipse.commander.feature" installMode="root"/> -->
      <feature id="de.jcup.batcheditor" installMode="root"/>
      <feature id="de.jcup.basheditor" installMode="root"/>
      <feature id="net.sourceforge.javahexeditor" installMode="root"/>
      <feature id="org.eclipse.mylyn.wikitext.feature" installMode="root"/>
      <feature id="org.eclipse.terminal.feature" installMode="root"/>
      <!-- non-p2: <feature id="org.dadacoalition.yedit.feature" installMode="root"/> -->
      <feature id="de.jcup.jenkinseditor.feature" installMode="root"/>

      <!-- Git + SVN -->
      <feature id="org.eclipse.egit" installMode="root"/>
      <feature id="org.eclipse.jgit.http.apache" installMode="root"/>
      <feature id="org.eclipse.egit.gitflow.feature" installMode="root"/>
      <feature id="org.eclipse.team.svn" installMode="root"/>
      <feature id="org.polarion.eclipse.team.svn.connector.svnkit1_10" installMode="root"/>

      <!-- Mylyn + connectors -->
      <feature id="org.eclipse.mylyn.commons.activity.feature" installMode="root"/>
      <feature id="org.eclipse.mylyn.egit.feature" installMode="root"/>
      <feature id="org.eclipse.mylyn.ide.feature" installMode="root"/>
      <feature id="org.eclipse.mylyn.git.feature" installMode="root"/>
      <feature id="org.eclipse.mylyn.github.feature" installMode="root"/>
      <feature id="org.eclipse.mylyn.jenkins.feature" installMode="root"/>
      <feature id="org.eclipse.mylyn.reviews.feature" installMode="root"/>
      <feature id="net.resheim.eclipse.timekeeper" installMode="root"/>

      <!-- Java -->
      <feature id="org.eclipse.jdt" installMode="root"/>
      <feature id="org.eclipse.jdt.bcoview.feature" installMode="root"/>
      <feature id="org.eclipse.eclemma.feature" installMode="root"/>
      <feature id="org.eclipse.m2e.feature" installMode="root"/>
      <feature id="org.eclipse.buildship" installMode="root"/>
      <feature id="org.eclipse.mylyn.jdt.feature" installMode="root"/>
      <feature id="com.github.spotbugs.plugin.eclipse" installMode="root"/>

      <!-- Plug-in Development Environment (PDE) and sources -->
      <feature id="org.eclipse.pde" installMode="root"/>
      <feature id="org.eclipse.pde.spies" installMode="root"/>
      <feature id="org.eclipse.m2e.pde.feature" installMode="root"/>
      <feature id="org.eclipse.e4.core.tools.feature" installMode="root"/>
      <feature id="org.eclipse.swt.tools.feature" installMode="root"/>
      <feature id="org.eclipse.rcp" installMode="root"/>
      <feature id="org.eclipse.mylyn.pde.feature" installMode="root"/>

      <!-- misc: "Repository Explorer" view -->
      <feature id="org.eclipse.oomph.targlets" installMode="root"/>

      <!-- web: HTML, JavaScript, XML, XSL (via both, WTP and Wild Web Developer) -->
      <feature id="org.eclipse.wst.web_ui.feature" installMode="root"/>
      <feature id="org.eclipse.wst.xml_ui.feature" installMode="root"/>
      <feature id="org.eclipse.wst.xsl.feature" installMode="root"/>
      <feature id="org.eclipse.wst.jsdt.feature" installMode="root"/>
      <feature id="org.eclipse.wildwebdeveloper.feature" installMode="root"/>
      <feature id="org.eclipse.wildwebdeveloper.embedder.node.feature" installMode="root"/>

   </features>

   <configurations>
      <plugin id="org.eclipse.core.runtime" autoStart="true" startLevel="4" />
      <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2" />
      <plugin id="org.apache.felix.scr" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.event" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.p2.reconciler.dropins" autoStart="true" startLevel="4" />
      <plugin id="org.eclipse.equinox.simpleconfigurator" autoStart="true" startLevel="1" />
      <property name="eclipse.buildId" value="${unqualifiedVersion}.${buildQualifier}" />
      <property name="org.eclipse.update.reconcile" value="false" />
      <property name="osgi.bundles.defaultStartLevel" value="4" />
      <property name="osgi.instance.area.default" value="@config.dir/../workspace" />
   </configurations>

</product>
